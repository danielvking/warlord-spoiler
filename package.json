{
  "name": "warlord-spoiler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node prebuild.js && vite --port 50005",
    "build": "node prebuild.js && vite build",
    "preview": "node prebuild.js && vite preview --port 50005",
    "test": "vitest run --config vitest.config.js",
    "test:unit": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "lint": "eslint --ext .js,.vue src",
    "test:visual": "playwright test --config playwright.config.js",
    "dev:lan": "node prebuild.js && vite --host 0.0.0.0 --port 50010"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "axios": "^0.21.4",
    "bootstrap": "^5.3.3",
    "bootstrap-vue-next": "^1.0.1",
    "core-js": "^2.6.5",
    "dom-to-image": "^2.6.0",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^3.2.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.8",
    "eslint": "^5.16.0",
    "eslint-plugin-vue": "^5.0.0",
    "jsdom": "^29.1.1",
    "sass": "^1.54.4",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^3.2.7",
    "vitest": "^0.34.6"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "rules": {}
  },
  "prettier": {
    "printWidth": 120
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
